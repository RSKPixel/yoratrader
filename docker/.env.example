APP_ENV=production

# Browser origins that will hit this stack
CORS_ORIGINS=http://localhost:8007,http://127.0.0.1:8007

# Kite
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# External Postgres (not managed by this compose file)
# Must be reachable FROM INSIDE the backend container.
# - Postgres on same Docker host: host.docker.internal
# - Remote / Tailscale host: hostname or IP reachable from the container
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=sysadmin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yoratrader
