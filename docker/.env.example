APP_ENV=production

# Browser origins that will hit this stack
CORS_ORIGINS=http://localhost:8007,http://127.0.0.1:8007,https://trader.yoratech.com

# If using Nginx Proxy Manager in front of this stack:
# - Enable "Websockets Support" on the proxy host
# - Or rely on SSE fallback (/api/events/stream) which does not need WS upgrade
# Optional proxy network overlay:
#   PROXY_NETWORK=npm_default docker compose -f docker-compose.yml -f docker-compose.proxy.yml up -d

# Kite
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# External Postgres (not managed by this compose file)
# Must be reachable FROM INSIDE the backend container.
# - Postgres on same Docker host: host.docker.internal
# - Remote / Tailscale host: hostname or IP reachable from the container
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=sysadmin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=yoratrader
